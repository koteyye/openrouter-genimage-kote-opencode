{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/koteyye/openrouter-genimage-kote-opencode/blob/v0.1.0/schema/plugin-options.schema.json",
  "title": "openrouter-genimage-kote-opencode plugin options",
  "description": "Strict options for the OpenCode plugin tuple. Runtime validation additionally enforces trim-aware strings and cross-field relationships.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "routing",
    "model"
  ],
  "properties": {
    "routing": {
      "type": "string",
      "enum": [
        "direct",
        "proxy"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "apiKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
    },
    "managementApiKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
    },
    "outputDirectory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[^\\u0000-\\u001F\\u007F]+$",
      "default": "assets/generated"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aspect_ratio": {
          "$ref": "#/$defs/imageAspectRatio"
        },
        "background": {
          "type": "string",
          "enum": [
            "auto",
            "transparent",
            "opaque"
          ]
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 1
        },
        "output_format": {
          "type": "string",
          "enum": [
            "png",
            "jpeg",
            "webp"
          ]
        },
        "output_compression": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "quality": {
          "type": "string",
          "enum": [
            "auto",
            "low",
            "medium",
            "high"
          ]
        },
        "resolution": {
          "type": "string",
          "enum": [
            "512",
            "1K",
            "2K",
            "4K"
          ]
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxReferences": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "default": 16
        },
        "maxFileBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 20971520
        },
        "maxTotalBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 52428800,
          "description": "Runtime validation requires maxTotalBytes to be greater than or equal to maxFileBytes. Standard JSON Schema cannot compare arbitrary sibling numeric values."
        }
      }
    },
    "requestTimeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "default": 300000
    },
    "modelCacheTtlMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "default": 3600000
    },
    "maxResponseBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "default": 134217728
    },
    "maxDecodedBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "default": 134217728
    }
  },
  "$defs": {
    "imageAspectRatio": {
      "type": "string",
      "enum": [
        "1:1",
        "1:2",
        "1:4",
        "1:8",
        "2:1",
        "2:3",
        "3:2",
        "3:4",
        "4:1",
        "4:3",
        "4:5",
        "5:4",
        "8:1",
        "9:16",
        "16:9",
        "9:19.5",
        "19.5:9",
        "9:20",
        "20:9",
        "9:21",
        "21:9",
        "auto"
      ]
    }
  }
}
